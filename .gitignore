# ==============================================================================
# GitNova — Production Git Ignore Rules
# ==============================================================================

# --- Python Environment & Bytecode ---
env/
backend/env/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
ingestion.lock

# --- JavaScript / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
.output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Secrets & Environment Configurations ---
# NEVER commit raw credentials or local .env files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Internal Research & Development Reports (Kept Local) ---
research/
designs/
*_report.md
*_audit.md
*_verification.md
*_before_after.md
FINAL_PRE_DEPLOYMENT_VALIDATION_REPORT.md
backend/FINAL_PRE_DEPLOYMENT_VALIDATION_REPORT.md
frontend/public/FINAL_PRE_DEPLOYMENT_VALIDATION_REPORT.md
backend/scripts/verify_production_pipeline_dry_run.py

# --- Editor / IDE / Operating System ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.aider*
*.log
logs/
backend/logs/
temp/
tmp/

# --- Local Scrap / Scratch Dumps ---
scratch/
.system_generated/
